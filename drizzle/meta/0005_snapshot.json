          "value": "\"concept_versions\".\"approved_by\" is null or \"concept_versions\".\"approved_by\" in ('reviewer', 'teacher')"
        },
        "concept_versions_kind_shape": {
          "name": "concept_versions_kind_shape",
          "value": "(\"concept_versions\".\"kind\" = 'summary' and \"concept_versions\".\"summary_bullets\" is not null\n            and cardinality(\"concept_versions\".\"summary_bullets\") between 3 and 6 and \"concept_versions\".\"illustration_svg\" is null)\n          or (\"concept_versions\".\"kind\" = 'illustration' and \"concept_versions\".\"illustration_svg\" is not null\n            and \"concept_versions\".\"illustration_brief\" is not null and \"concept_versions\".\"illustration_alt\" is not null\n            and \"concept_versions\".\"summary_bullets\" is null)"
        },
        "concept_versions_approved_fields": {
          "name": "concept_versions_approved_fields",
          "value": "\"concept_versions\".\"status\" <> 'approved'\n          or (\"concept_versions\".\"approved_by\" is not null and \"concept_versions\".\"reviewed_at\" is not null\n            and (\"concept_versions\".\"approved_by\" <> 'reviewer' or \"concept_versions\".\"reviewer_model\" is not null))"
        },
        "concept_versions_failed_fields": {
