# Copy to .env.local for local dev. Set the real values in the Vercel dashboard
# (Project > Settings > Environment Variables). Set Production and Preview
# SEPARATELY: Preview must use a different, non-production database.
# .env.local is gitignored — never commit a real key. Nothing here is prefixed
# NEXT_PUBLIC_: all of it is read only in server-side code.

# --- Required in production ------------------------------------------------
# If any of AUTH_SECRET, AUTH_GOOGLE_ID, AUTH_GOOGLE_SECRET or DATABASE_URL is
# missing, a production build (NODE_ENV=production, which includes Vercel
# Previews) REFUSES TO SERVE: every request gets a 503. It never falls back to
# open access.

# Neon Postgres connection string. Create the project in AWS ap-southeast-2
# (Sydney) so student data stays in Australia. For Previews, use a branch made
# from an empty, schema-only branch, never from production.
DATABASE_URL=

# Signs sessions and the attempt / receipt / self-mark tokens. Make one with:
#   npx auth secret
AUTH_SECRET=

# Google OAuth client (any Google account may sign in).
# Redirect URI: https://<your-domain>/api/auth/callback/google
# Locally, leave these blank to use the Dev login on the sign-in page (it only
# exists when NODE_ENV is not "production").
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Shared secret for the weekly retention job (/api/cron/retention). Vercel Cron
# sends it as "Authorization: Bearer <value>" when this variable is set. Without
# it the route answers 503 and nobody is deleted.
CRON_SECRET=

# --- LLM short-answer grading (optional) -----------------------------------
# OpenRouter API key: https://openrouter.ai/keys
# If unset, short answers fall back to student self-marking.
OPENROUTER_API_KEY=

# Model slug used to grade short answers.
GRADING_MODEL=deepseek/deepseek-chat

# Canonical site URL, sent to OpenRouter as HTTP-Referer (optional).
SITE_URL=

# --- Cost and abuse controls (optional; defaults shown) ---------------------
# AI-graded short answers per student per Sydney calendar day. Over the limit
# the student self-marks. 0 turns AI marking off. Multiple choice is unlimited.
LLM_DAILY_CAP=40

# Short-answer submissions per signed-in student per minute (primary limit).
GRADE_RATE_LIMIT=20

# Looser per-IP backstop per minute (a school shares one address).
GRADE_IP_RATE_LIMIT=150

# Attempts a student can start per minute.
ATTEMPT_RATE_LIMIT=20

# Upstash Redis for distributed rate limiting across serverless instances
# (create the database in ap-southeast-2). If unset, an in-memory per-instance
# limiter is used instead.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
