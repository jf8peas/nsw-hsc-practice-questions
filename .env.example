# Copy to .env.local for local dev. Set the real values in the Vercel dashboard
# (Project > Settings > Environment Variables) for Preview + Production.
# .env.local is gitignored — never commit a real key.

# --- LLM grading (wired up in step 3, not used yet) ---
# OpenRouter API key: https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Model slug used to grade short answers, e.g. deepseek/deepseek-chat
GRADING_MODEL=deepseek/deepseek-chat

# --- Access gate for short-answer grading ---
# Shared code students enter once to unlock marking. Leave unset = no gate.
CLASS_CODE=

# Set to "true" to bypass the class code even when CLASS_CODE is set —
# anyone can then use short-answer grading without a code.
SKIP_CLASS_CODE=
