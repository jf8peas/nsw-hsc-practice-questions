# Copy to .env.local for local dev. Set the real values in the Vercel dashboard
# (Project > Settings > Environment Variables) for Preview + Production.
# .env.local is gitignored — never commit a real key.

# --- LLM short-answer grading ---
# OpenRouter API key: https://openrouter.ai/keys
# If unset, short answers fall back to student self-marking.
OPENROUTER_API_KEY=

# Model slug used to grade short answers.
GRADING_MODEL=deepseek/deepseek-chat

# Canonical site URL, sent to OpenRouter as HTTP-Referer (optional).
SITE_URL=

# --- Access gate for short-answer grading ---
# Shared code students enter once to unlock marking. Leave unset = no gate.
CLASS_CODE=

# Set to "true" to bypass the class code even when CLASS_CODE is set —
# anyone can then use short-answer grading without a code.
SKIP_CLASS_CODE=

# --- Rate limiting (short-answer path only) ---
# Max short-answer submissions per IP per minute (default 30).
GRADE_RATE_LIMIT=

# Upstash Redis for distributed rate limiting across serverless instances.
# If unset, an in-memory per-instance limiter is used instead.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
